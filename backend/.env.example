# ATTENTION : ce fichier .env n'est PAS chargé automatiquement par
# l'application (aucun mécanisme de lecture de .env dans le code — les
# variables sont lues directement dans l'environnement du process via
# os.environ). Il sert uniquement de mémo des valeurs à renseigner.
# Pour qu'une valeur soit réellement prise en compte, elle doit être
# définie comme variable d'environnement du process qui exécute
# l'application — via NSSM (onglet Environment / AppEnvironmentExtra,
# voir §8.4 et §8.11 de la documentation technique) en production, ou
# via $env:VARIABLE = "valeur" dans la console avant de lancer uvicorn
# pour un test local.
#
# Copier ce fichier en .env, y renseigner une vraie valeur secrète,
# puis reporter cette même valeur dans la configuration du service.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_hex(32))"
RFID_SECRET_KEY=

# Optionnel : origines externes autorisées à appeler l'API (liste séparée
# par des virgules). L'UI Jinja2 est servie en same-origin, donc inutile
# pour elle. Laisser vide si aucune intégration externe n'appelle l'API
# depuis un navigateur.
CORS_ALLOWED_ORIGINS=

# Mettre à "true" en production si l'application est servie en HTTPS,
# pour que le cookie de session ne soit envoyé que sur des connexions
# chiffrées.
COOKIE_SECURE=false
