# Copier ce fichier en .env et renseigner une vraie valeur secrète.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_hex(32))"
RFID_SECRET_KEY=

# Optionnel : origines externes autorisées à appeler l'API (liste séparée
# par des virgules). L'UI Jinja2 est servie en same-origin, donc inutile
# pour elle. Laisser vide si aucune intégration externe n'appelle l'API
# depuis un navigateur.
CORS_ALLOWED_ORIGINS=

# Mettre à "true" en production si l'application est servie en HTTPS,
# pour que le cookie de session ne soit envoyé que sur des connexions
# chiffrées.
COOKIE_SECURE=false
