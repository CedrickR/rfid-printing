# Copier ce fichier en .env et renseigner une vraie valeur secrète.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_hex(32))"
RFID_SECRET_KEY=

# Origines autorisées pour le frontend (liste séparée par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
